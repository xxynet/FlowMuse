# Copy to .env inside server/. Never commit .env or real credentials.
FLOWMUSE_DATABASE_URL=sqlite+aiosqlite:///./data/flowmuse.db
FLOWMUSE_PROVIDER_BASE_URL=https://api.openai.com/v1
FLOWMUSE_PROVIDER_API_KEY=
FLOWMUSE_REQUEST_TIMEOUT=120
FLOWMUSE_RUN_TIMEOUT=900
FLOWMUSE_MAX_OUTPUT_TOKENS=2048
FLOWMUSE_MAX_CONCURRENT_RUNS=2
FLOWMUSE_MAX_PENDING_RUNS=16
